{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-de-project-avi"
		},
		"ls_sql_control_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sql_control'"
		},
		"ls_adls_gen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stdeprojectavi2026.dfs.core.windows.net/"
		},
		"ls_sql_control_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-de-project-avi.database.windows.net"
		},
		"ls_sql_control_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-de-control"
		},
		"ls_sql_control_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Abhi_admin"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ls_adls_gen2')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_adls_gen2_properties_typeProperties_url')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_sql_control')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_sql_control_properties_typeProperties_server')]",
					"database": "[parameters('ls_sql_control_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_sql_control_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_sql_control_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_bronze_csv')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_adls_gen2",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_folder_path": {
						"type": "string"
					},
					"p_file_name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().p_file_name",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().p_folder_path",
							"type": "Expression"
						},
						"fileSystem": "bronze"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_adls_gen2')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_etl_control')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_sql_control",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "pipeline_name",
						"type": "varchar"
					},
					{
						"name": "source_system",
						"type": "varchar"
					},
					{
						"name": "source_object",
						"type": "varchar"
					},
					{
						"name": "watermark_column",
						"type": "varchar"
					},
					{
						"name": "watermark_value",
						"type": "varchar"
					},
					{
						"name": "last_run_id",
						"type": "varchar"
					},
					{
						"name": "last_run_status",
						"type": "varchar"
					},
					{
						"name": "last_run_start_time",
						"type": "datetime2",
						"scale": 7
					},
					{
						"name": "last_success_time",
						"type": "datetime2",
						"scale": 7
					},
					{
						"name": "rows_processed",
						"type": "bigint",
						"precision": 19
					},
					{
						"name": "error_message",
						"type": "varchar"
					},
					{
						"name": "is_active",
						"type": "bit"
					}
				],
				"typeProperties": {
					"schema": "dbo",
					"table": "etl_control"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_sql_control')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_etl_file_history')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_sql_control",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "pipeline_name",
						"type": "varchar"
					},
					{
						"name": "source_file_name",
						"type": "varchar"
					},
					{
						"name": "source_path",
						"type": "varchar"
					},
					{
						"name": "file_modified_time",
						"type": "datetime2",
						"scale": 3
					},
					{
						"name": "processed_time",
						"type": "datetime2",
						"scale": 3
					},
					{
						"name": "run_id",
						"type": "varchar"
					},
					{
						"name": "status",
						"type": "varchar"
					},
					{
						"name": "rows_processed",
						"type": "bigint",
						"precision": 19
					},
					{
						"name": "error_message",
						"type": "varchar"
					}
				],
				"typeProperties": {
					"schema": "dbo",
					"table": "etl_file_history"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_sql_control')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_source_oj_sales')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_adls_gen2",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_file_name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().p_file_name",
							"type": "Expression"
						},
						"fileSystem": "source"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "rownames",
						"type": "String"
					},
					{
						"name": "Purchase",
						"type": "String"
					},
					{
						"name": "WeekofPurchase",
						"type": "String"
					},
					{
						"name": "StoreID",
						"type": "String"
					},
					{
						"name": "PriceCH",
						"type": "String"
					},
					{
						"name": "PriceMM",
						"type": "String"
					},
					{
						"name": "DiscCH",
						"type": "String"
					},
					{
						"name": "DiscMM",
						"type": "String"
					},
					{
						"name": "SpecialCH",
						"type": "String"
					},
					{
						"name": "SpecialMM",
						"type": "String"
					},
					{
						"name": "LoyalCH",
						"type": "String"
					},
					{
						"name": "SalePriceMM",
						"type": "String"
					},
					{
						"name": "SalePriceCH",
						"type": "String"
					},
					{
						"name": "PriceDiff",
