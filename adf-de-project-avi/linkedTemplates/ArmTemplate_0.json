					},
					{
						"name": "PctDiscMM",
						"type": "String"
					},
					{
						"name": "PctDiscCH",
						"type": "String"
					},
					{
						"name": "ListPriceDiff",
						"type": "String"
					},
					{
						"name": "STORE",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_adls_gen2')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_ingest_oj_sales_to_bronze')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Get_Metadata_Source_Files",
						"type": "GetMetadata",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "ds_source_oj_sales",
								"type": "DatasetReference",
								"parameters": {
									"p_file_name": {
										"value": "@''",
										"type": "Expression"
									}
								}
							},
							"fieldList": [
								"childItems"
							],
							"storeSettings": {
								"type": "AzureBlobFSReadSettings",
								"recursive": true,
								"enablePartitionDiscovery": false
							},
							"formatSettings": {
								"type": "DelimitedTextReadSettings"
							}
						}
					},
					{
						"name": "ForEach1",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Get_Metadata_Source_Files",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Get_Metadata_Source_Files').output.childItems",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "Lookup_File_History",
									"type": "Lookup",
									"dependsOn": [
										{
											"activity": "Get_Metadata_Current_File",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat(\n  'SELECT COUNT(*) AS processed_count\n   FROM dbo.etl_file_history\n   WHERE pipeline_name = ''pl_ingest_oj_sales_to_bronze''\n   AND source_file_name = ''',\n   item().name,\n   '''\n   AND file_modified_time = ''',activity('Get_Metadata_Current_File').output.lastModified,'''\n   AND status = ''Succeeded'';'\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "ds_etl_file_history",
											"type": "DatasetReference",
											"parameters": {}
										}
									}
								},
								{
									"name": "If Condition1",
									"type": "IfCondition",
									"dependsOn": [
										{
											"activity": "Lookup_File_History",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"expression": {
											"value": "@equals(\r\n  int(activity('Lookup_File_History').output.firstRow.processed_count),\r\n  0\r\n)",
											"type": "Expression"
										},
										"ifTrueActivities": [
											{
												"name": "Copy_OJ_Sales_To_Bronze",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "DelimitedTextSource",
														"storeSettings": {
															"type": "AzureBlobFSReadSettings",
															"recursive": true,
															"enablePartitionDiscovery": false
														},
														"formatSettings": {
															"type": "DelimitedTextReadSettings"
														}
													},
													"sink": {
														"type": "DelimitedTextSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "DelimitedTextWriteSettings",
															"quoteAllText": true,
															"fileExtension": ".txt"
														}
													},
													"enableStaging": false,
													"translator": {
														"type": "TabularTranslator",
														"typeConversion": true,
														"typeConversionSettings": {
															"allowDataTruncation": true,
															"treatBooleanAsNumber": false
														}
													}
												},
												"inputs": [
													{
														"referenceName": "ds_source_oj_sales",
														"type": "DatasetReference",
														"parameters": {
															"p_file_name": {
																"value": "@item().name",
																"type": "Expression"
															}
														}
													}
												],
												"outputs": [
													{
														"referenceName": "ds_bronze_csv",
														"type": "DatasetReference",
														"parameters": {
															"p_folder_path": {
																"value": "@concat(\n  'oj_sales/ingestion_date=',\n  formatDateTime(utcnow(),'yyyy-MM-dd')\n)",
																"type": "Expression"
															},
															"p_file_name": {
																"value": "@item().name",
																"type": "Expression"
															}
														}
													}
												]
											},
											{
												"name": "Script_Log_File_Success",
												"type": "Script",
												"dependsOn": [
													{
														"activity": "Copy_OJ_Sales_To_Bronze",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"linkedServiceName": {
													"referenceName": "ls_sql_control",
													"type": "LinkedServiceReference"
												},
												"typeProperties": {
													"scripts": [
														{
															"type": "Query",
															"text": {
																"value": "@concat(\n'INSERT INTO dbo.etl_file_history\n(\n    pipeline_name,\n    source_file_name,\n    source_path,\n    file_modified_time,\n    processed_time,\n    run_id,\n    status,\n    files_written,\n    data_written_bytes\n)\nVALUES\n(\n    ''pl_ingest_oj_sales_to_bronze'',\n    ''', item().name, ''',\n    ''source'',\n    ''', activity('Get_Metadata_Current_File').output.lastModified, ''',\n    SYSUTCDATETIME(),\n    ''', pipeline().RunId, ''',\n    ''Succeeded'',\n    ''',activity('Copy_OJ_Sales_To_Bronze').output.filesWritten,''',\n    ''',activity('Copy_OJ_Sales_To_Bronze').output.dataWritten,'''\n);'\n)",
																"type": "Expression"
															}
														}
													],
													"scriptBlockExecutionTimeout": "02:00:00"
												}
											},
											{
												"name": "Script_Log_File_Failure",
												"type": "Script",
												"dependsOn": [
													{
														"activity": "Copy_OJ_Sales_To_Bronze",
														"dependencyConditions": [
															"Failed"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"linkedServiceName": {
													"referenceName": "ls_sql_control",
													"type": "LinkedServiceReference"
												},
												"typeProperties": {
													"scripts": [
														{
															"type": "Query",
															"text": {
																"value": "@concat(\n'INSERT INTO dbo.etl_file_history\n(\n    pipeline_name,\n    source_file_name,\n    source_path,\n    file_modified_time,\n    processed_time,\n    run_id,\n    status,\n    error_message\n)\nVALUES\n(\n    ''pl_ingest_oj_sales_to_bronze'',\n    ''', item().name, ''',\n    ''source'',\n    ''', activity('Get_Metadata_Current_File').output.lastModified, ''',\n    SYSUTCDATETIME(),\n    ''', pipeline().RunId, ''',\n    ''Failed'',\n    ''',replace(string(activity('Copy_OJ_Sales_To_Bronze').error.message),'''',''''''),'''\n);'\n)",
																"type": "Expression"
															}
														}
													],
													"scriptBlockExecutionTimeout": "02:00:00"
												}
											}
										]
									}
								},
								{
									"name": "Get_Metadata_Current_File",
									"type": "GetMetadata",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"dataset": {
											"referenceName": "ds_source_oj_sales",
											"type": "DatasetReference",
											"parameters": {
												"p_file_name": {
													"value": "@item().name",
													"type": "Expression"
												}
											}
										},
										"fieldList": [
											"lastModified"
										],
										"storeSettings": {
											"type": "AzureBlobFSReadSettings",
											"recursive": true,
											"enablePartitionDiscovery": false
										},
										"formatSettings": {
											"type": "DelimitedTextReadSettings"
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_source_oj_sales')]",
				"[concat(variables('factoryId'), '/datasets/ds_etl_file_history')]",
				"[concat(variables('factoryId'), '/datasets/ds_bronze_csv')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_sql_control')]"
			]
		}
	]
}